{
  "name": "saja",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SAJA — سَجَى · The Islamic Interactive Journey",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "PORT=8787 tsx watch --env-file-if-exists=.env --tsconfig server/tsconfig.json server/index.ts",
    "build": "tsc -b && vite build",
    "start": "SAJA_ENV=production tsx --env-file-if-exists=.env --tsconfig server/tsconfig.json server/index.ts",
    "saja": "tsx --env-file-if-exists=.env --tsconfig server/tsconfig.json server/cli.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "SAJA_LIVE_TESTS=1 node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run server/test/live.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "e2e": "sh e2e/serve.sh && node e2e/journey.mjs && sh e2e/serve.sh && node e2e/child.mjs && sh e2e/staff.sh",
    "e2e:visual": "sh e2e/serve.sh && node e2e/visual.mjs setup && node e2e/visual.mjs shots",
    "e2e:a11y": "sh e2e/serve.sh && node e2e/visual.mjs setup && node e2e/a11y.mjs",
    "e2e:game": "npm run build && sh e2e/serve.sh && node e2e/game.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.10",
    "motion": "^13.4.4",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "concurrently": "^9.2.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19"
  }
}
