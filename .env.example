# ─────────────────────────────────────────────────────────────────────────────
# SAJA server configuration. Copy to `.env` and fill in what you have.
# Every external service is OPTIONAL: when a key is missing the product runs an
# honest local fallback and says so in the UI (see GET /api/system/status).
# Secrets below are read ONLY by the server process — never prefix them with
# VITE_ and never import them in src/.
# Check what works:  npm run saja -- doctor   (PASS / FAIL / NOT CONFIGURED / NOT TESTED)
# ─────────────────────────────────────────────────────────────────────────────

SAJA_ENV=development            # [REQUIRED] production in production
PORT=8787
APP_ORIGIN=http://localhost:5173 # [REQUIRED] exact public origin of the web app (CSRF origin check)
TRUST_PROXY=false               # [REQUIRED behind a proxy] true only behind a reverse proxy you control
# COOKIE_SECURE=true            # leave unset (true in production); false is DEVELOPMENT ONLY
# STATIC_DIR=./dist             # production default: serve the built app from this process

# ── Database ── [REQUIRED FOR PRODUCTION] Postgres 15+ with the pgvector extension (Neon, Supabase, RDS, Cloud SQL…).
# Unset → embedded PGlite (real Postgres in WASM) stored in PGLITE_DIR. Single instance only.
# DATABASE_URL=postgres://user:pass@host:5432/saja?sslmode=require
PGLITE_DIR=./.data/pglite       # DEVELOPMENT ONLY

# ── AI providers ── [OPTIONAL] free-tier keys from your own accounts. Server-side only.
# Docs: docs/AI_PROVIDERS.md. Routing order (first configured one that can do the task):
#   Gemini (primary: text, images, PDFs, audio, video, embeddings) → Groq → OpenRouter → Mistral
#   → curated offline answers when none works. Anthropic is optional, PAID, and off unless SAJA_AI_ALLOW_PAID=true.
# None set → offline mode: extractive answers from curated knowledge; OCR/transcription report "unavailable".
# Free tiers have limits and their terms (incl. data use) change: check each provider before enabling it.
# GEMINI_API_KEY=                     # https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.5-flash-lite  # default; must accept the inputs you need (audio for voice notes)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GROQ_API_KEY=                       # https://console.groq.com/keys — fast text
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=                 # https://openrouter.ai/keys — fallback infrastructure only
# OPENROUTER_MODEL=openrouter/free    # the free-models router, or any model id ending in :free
# MISTRAL_API_KEY=                    # https://console.mistral.ai — another fallback
# MISTRAL_MODEL=mistral-small-latest
# ANTHROPIC_API_KEY=                  # [OPTIONAL, PAID] kept for future use
# ANTHROPIC_MODEL=claude-opus-5       # (SAJA_AI_MODEL is still read as an alias)
SAJA_AI_ALLOW_PAID=false              # zero-budget default: providers marked paid are never called
# SAJA_AI_PROVIDER_ORDER=gemini,groq,openrouter,mistral,anthropic
# SAJA_AI_CAPABILITIES=groq=text,structured_output,vision   # only if you pick a model that really has them
# SAJA_AI_LIMITS=gemini=200/10,groq=1000/30,openrouter=50/20,mistral=500/30,gemini-embeddings=500/60
#                                     # SAJA's own caps: requests per day / per minute. Set them to YOUR plan's allowance.
# SAJA_AI_SENSITIVE_PROVIDERS=gemini,groq,mistral,anthropic # providers allowed to see personal questions (scholar organising)
SAJA_AI_TIMEOUT_MS=45000
SAJA_AI_DAILY_CALLS_PER_USER=60       # cost control: model calls per user per day (cache hits are free)

# ── Embeddings for retrieval (RAG) ── [OPTIONAL, recommended]
# auto = Gemini embeddings if GEMINI_API_KEY, else Voyage if VOYAGE_API_KEY, else local lexical (keyword-level).
# Changing provider/model re-indexes the library automatically at the next start-up.
SAJA_EMBEDDINGS=auto                  # auto | gemini | voyage | local
# VOYAGE_API_KEY=                     # alternative embedding provider
VOYAGE_MODEL=voyage-3.5

# ── Transcription (AMANAH/NOUR audio & video) ── [OPTIONAL] any Whisper-compatible /audio/transcriptions endpoint.
# Unset → Gemini reads audio/video natively if GEMINI_API_KEY is set; otherwise audits report "transcription unavailable".
# Groq's free Whisper also works: TRANSCRIPTION_API_URL=https://api.groq.com/openai/v1/audio/transcriptions,
#   TRANSCRIPTION_API_KEY=<your GROQ key>, TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# ── Video on-screen text (AMANAH/NOUR) ── [OPTIONAL] local ffmpeg binary + a vision provider.
# Not needed while a provider reads video natively (Gemini).
# Unset → videos are checked from their transcript only, and the result says on-screen text was not read.
# FFMPEG_PATH=/usr/bin/ffmpeg

# ── Web Push ── [OPTIONAL] generate with: npm run saja -- vapid   (unset → in-app notifications only)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@saja.app

# ── Email (password reset) ── [REQUIRED if people should reset passwords] unset → email_outbox table (DEVELOPMENT ONLY)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM=SAJA <no-reply@saja.app>

# ── Uploads ── [OPTIONAL] stored privately on disk; never served publicly. Back this up.
UPLOAD_DIR=./.data/uploads
MAX_UPLOAD_MB=20
